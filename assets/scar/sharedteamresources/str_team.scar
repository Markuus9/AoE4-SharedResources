---------------------------------------------------------------------------------------------------
-- SharedResources - Población máxima y producción compartidas
--
-- Dos extras opcionales para los miembros de cada reserva (casillas del lobby
-- "Población máxima compartida" y "Producción compartida"):
--
-- 1. POBLACIÓN COMPARTIDA (casas + tope máximo)
--    El equipo junta dos cosas:
--      * el TOPE MÁXIMO (el 200): 2 jugadores = 400;
--      * la CAPACIDAD DE LAS CASAS: cada casa de cualquiera suma al equipo.
--    En cada tick:
--      casas_equipo = min(suma(casas_j), tope_equipo)
--      libre_casas  = casas_equipo - suma(usada_j)
--      libre_tope   = tope_equipo  - suma(usada_j)
--      capacidad_j  = usada_j + libre_casas     (Player_SetPopCapOverride)
--      tope_j       = usada_j + libre_tope      (Player_SetMaxCapPopulation)
--    Así cualquiera puede producir mientras quede hueco en el EQUIPO, y si uno
--    hace una casa el hueco crece para todos.
--    El contador del juego (usada/capacidad) solo cuenta TUS unidades: verás
--    "tus unidades / tus unidades + hueco del equipo". El total del equipo se
--    muestra encima de los botones de bloqueo ("Equipo: 17/40").
--    Lo que dan las casas de cada jugador se lee quitando un momento el
--    override (Player_ClearPopCapOverride) una vez por segundo.
--    Si dos jugadores producen a la vez la última unidad que cabe, el equipo
--    puede pasarse en esa unidad (igual que la deuda de recursos).
--
-- 2. PRODUCCIÓN COMPARTIDA
--    Los edificios con cola de producción de cada miembro se marcan con
--    Entity_SetSharedProductionQueue: los aliados pueden producir e investigar
--    en ellos pagando con SUS recursos (que, con la reserva, son los comunes).
--    Se aplica al empezar, al terminar cada construcción y con un repaso
--    periódico para los edificios que aparezcan de otra forma.
--
-- Todo se ejecuta dentro de la simulación (reglas y eventos): determinista.
---------------------------------------------------------------------------------------------------

STR_TEAM = {
	production_rule_interval = 15,   -- segundos entre repasos de edificios
	production_started = false,
	houses_refresh_ticks = 8,        -- cada cuántos ticks se vuelve a leer lo que dan las casas
}

---------------------------------------------------------------------------------------------------
-- Población compartida (casas + tope máximo)
---------------------------------------------------------------------------------------------------

-- Guarda el tope inicial de cada miembro. Se llama al crear la reserva.
function STR_Population_Init(pool)
	pool.pop = {
		base = {},       -- tope máximo inicial de cada miembro (normalmente 200)
		offset = {},     -- diferencia entre lo que fijamos y el tope efectivo (modificadores)
		houses = {},     -- capacidad que dan las casas de cada miembro (sin override)
		override = {},   -- capacidad que le hemos fijado con el override
		ticks = 0,
		team_used = 0, team_cap = 0, team_max = 0,
	}
	for _, id in ipairs(pool.members) do
		pool.pop.base[id] = Player_GetMaxPopulationCap(id, CT_Personnel)
		pool.pop.houses[id] = Player_GetCurrentPopulationCap(id, CT_Personnel)
	end
end

-- Tope del equipo: suma de los topes iniciales de los miembros que quedan.
function STR_Population_TeamMax(pool)
	local total = 0
	for _, id in ipairs(pool.members) do
		total = total + (pool.pop.base[id] or 0)
	end
	return total
end

-- Capacidad de las casas del equipo: suma de las de los miembros, sin pasar del tope.
function STR_Population_TeamHouses(pool)
	local total = 0
	for _, id in ipairs(pool.members) do
		total = total + (pool.pop.houses[id] or 0)
	end
	return math.min(total, STR_Population_TeamMax(pool))
end

-- Reparte un total entre los miembros: cada uno = lo que usa + el hueco libre
-- del equipo (lógica pura, testeable). used = { [id] = población usada }.
function STR_Population_Split(pool, used, total)
	local total_used = 0
	for _, id in ipairs(pool.members) do
		total_used = total_used + (used[id] or 0)
	end
	local free = total - total_used
	if free < 0 then
		free = 0
	end
	local targets = {}
	for _, id in ipairs(pool.members) do
		targets[id] = math.floor((used[id] or 0) + free)
	end
	return targets, total_used
end

-- Topes máximos de cada miembro (se mantiene por compatibilidad con las pruebas).
function STR_Population_Targets(pool, used)
	return (STR_Population_Split(pool, used, STR_Population_TeamMax(pool)))
end

-- Lee lo que dan las casas de un jugador: quita el override un momento, lee y
-- vuelve a ponerlo. Todo en el mismo tick de simulación.
local function STR_Population_ReadHouses(pool, id)
	if pool.pop.override[id] ~= nil then
		Player_ClearPopCapOverride(id)
	end
	pool.pop.houses[id] = Player_GetCurrentPopulationCap(id, CT_Personnel)
	if pool.pop.override[id] ~= nil then
		Player_SetPopCapOverride(id, pool.pop.override[id])
	end
end

-- Fija el tope efectivo de un jugador. Player_SetMaxCapPopulation aplica los
-- modificadores encima, así que se mide la diferencia la primera vez y se
-- compensa en las siguientes.
local function STR_Population_Apply(pool, id, target)
	local offset = pool.pop.offset[id] or 0
	local value = target - offset
	Player_SetMaxCapPopulation(id, CT_Personnel, value)
	local effective = Player_GetMaxPopulationCap(id, CT_Personnel)
	pool.pop.offset[id] = effective - value
	if effective ~= target and pool.pop.offset[id] ~= offset then
		-- Había modificadores que no conocíamos: se corrige una vez más.
		value = target - pool.pop.offset[id]
		Player_SetMaxCapPopulation(id, CT_Personnel, value)
	end
end

function STR_Population_Sync(pool)
	if pool.pop == nil or #pool.members == 0 then
		return
	end
	-- Lo que dan las casas cambia poco (al construir o perder casas): se relee
	-- cada houses_refresh_ticks ticks.
	pool.pop.ticks = pool.pop.ticks + 1
	if pool.pop.ticks % STR_TEAM.houses_refresh_ticks == 1 then
		for _, id in ipairs(pool.members) do
			STR_Population_ReadHouses(pool, id)
		end
	end

	local used = {}
	for _, id in ipairs(pool.members) do
		used[id] = Player_GetCurrentPopulation(id, CT_Personnel)
	end
	local team_max = STR_Population_TeamMax(pool)
	local team_cap = STR_Population_TeamHouses(pool)
	local max_targets, team_used = STR_Population_Split(pool, used, team_max)
	local cap_targets = STR_Population_Split(pool, used, team_cap)

	for _, id in ipairs(pool.members) do
		-- Primero el tope (siempre >= capacidad), luego la capacidad.
		if Player_GetMaxPopulationCap(id, CT_Personnel) ~= max_targets[id] then
			STR_Population_Apply(pool, id, max_targets[id])
		end
		if pool.pop.override[id] ~= cap_targets[id] then
			Player_SetPopCapOverride(id, cap_targets[id])
			pool.pop.override[id] = cap_targets[id]
		end
	end

	-- Totales del equipo para el texto de la interfaz.
	if pool.pop.team_used ~= team_used or pool.pop.team_cap ~= team_cap or pool.pop.team_max ~= team_max then
		pool.pop.team_used = team_used
		pool.pop.team_cap = team_cap
		pool.pop.team_max = team_max
		STR_UI_RefreshPopulation(pool)
	end
end

-- Al eliminar a un miembro se deja de contar su tope y sus casas.
function STR_Population_RemoveMember(pool, id)
	if pool.pop == nil then
		return
	end
	pool.pop.base[id] = nil
	pool.pop.houses[id] = nil
	pool.pop.override[id] = nil
end

---------------------------------------------------------------------------------------------------
-- Producción compartida
---------------------------------------------------------------------------------------------------

local function STR_Production_ShareEntity(entity)
	if entity ~= nil and Entity_HasProductionQueue(entity) then
		Entity_SetSharedProductionQueue(entity, true)
		return true
	end
	return false
end

-- Marca todos los edificios con cola de producción de un jugador.
function STR_Production_SharePlayer(player_id)
	local count = 0
	local eg = Player_GetEntities(player_id)
	EGroup_ForEach(eg, function(group, index, entity)
		if STR_Production_ShareEntity(entity) then
			count = count + 1
		end
		return false
	end)
	return count
end

function STR_Production_ShareAll()
	for _, pool in ipairs(STR_STATE.pools) do
		for _, id in ipairs(pool.members) do
			STR_Production_SharePlayer(id)
		end
	end
end

function STR_Production_Start()
	if STR_TEAM.production_started then
		return
	end
	STR_TEAM.production_started = true
	STR_Production_ShareAll()
	Rule_AddGlobalEvent(STR_Production_OnConstructionComplete, GE_ConstructionComplete)
	Rule_AddInterval(STR_Production_ShareAll, STR_TEAM.production_rule_interval)
	STR_LogEvent("Producción compartida activada")
end

function STR_Production_Stop()
	if not STR_TEAM.production_started then
		return
	end
	if Rule_RemoveGlobalEvent ~= nil then
		Rule_RemoveGlobalEvent(STR_Production_OnConstructionComplete)
	end
	if Rule_Exists(STR_Production_ShareAll) then
		Rule_Remove(STR_Production_ShareAll)
	end
	STR_TEAM.production_started = false
end

-- Al terminar una construcción de un miembro de una reserva, se comparte.
function STR_Production_OnConstructionComplete(context)
	if context == nil or context.player == nil then
		return
	end
	local player = Core_GetPlayersTableEntry(context.player)
	if player == nil or STR_STATE.pool_of[player.id] == nil then
		return
	end
	STR_Production_ShareEntity(context.entity)
end
