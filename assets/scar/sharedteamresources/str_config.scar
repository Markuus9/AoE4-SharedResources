---------------------------------------------------------------------------------------------------
-- SharedResources - Configuración
--
-- Todos los valores ajustables del mod están aquí. No contiene lógica.
-- El script principal del modo (SharedTeamResources.scar) sobrescribe algunos
-- valores según las opciones del lobby (`enabled`, `lock_ui`, `messages`).
---------------------------------------------------------------------------------------------------

STR_CONFIG = {
	-- Activa o desactiva el mod por completo. Lo fija la opción del lobby
	-- "Recursos compartidos".
	enabled = true,

	-- Número máximo de jugadores que pueden compartir una reserva. Lo fija la
	-- opción del lobby "Jugadores por reserva" (2, 3 o 4). Los equipos con más
	-- miembros no comparten (y, con los avisos de depuración, se dice por qué).
	max_players_per_pool = 4,

	-- Número mínimo de jugadores para crear una reserva. Con 1 no tiene sentido.
	min_players_per_pool = 2,

	-- Solo comparten los equipos con al menos un humano: los equipos formados
	-- solo por IA (p. ej. los enemigos) nunca comparten.
	-- Si es true, una IA aliada de un humano también entra en la reserva
	-- (útil para jugar o probar en solitario). Si es false, solo humanos.
	-- Lo fija la opción del lobby "Incluir IA aliada".
	ai_allies = true,

	-- Avisos de depuración en pantalla: al empezar dicen si tu equipo comparte
	-- y por qué no, y si se ha creado el panel de botones. Lo fija la opción
	-- del lobby "Avisos de depuración". (Los mensajes de print() del log no se
	-- ven en la versión normal del juego; esto sí.)
	debug = false,

	-- Cada cuánto se sincroniza la reserva, en segundos.
	-- 0 = cada tick de simulación (Rule_Add). Es lo recomendado: reduce la
	-- ventana de gastos simultáneos al mínimo posible.
	sync_interval = 0,

	-- Registro con print() (no visible en la versión normal del juego; ver str_log.scar).
	--   0 = nada, 1 = errores y avisos, 2 = eventos (deuda, bloqueos, equipos),
	--   3 = traza de cada sincronización con cambios (muy verboso)
	log_level = 2,

	-- Muestra avisos en pantalla (event cues): reserva activada, deuda por gasto
	-- simultáneo y bloqueos/desbloqueos del aliado.
	notify = true,

	-- Población máxima compartida: el equipo suma su tope de población (p. ej.
	-- 400 entre dos) y cada uno puede usar lo que los demás no usan.
	-- Lo fija la casilla del lobby "Población máxima compartida".
	share_population = true,

	-- Producción compartida: los aliados pueden producir e investigar en tus
	-- edificios. Lo fija la casilla del lobby "Producción compartida".
	share_production = true,

	-- Botones de bloqueo en pantalla. Lo fija la opción del lobby
	-- "Botones de bloqueo".
	lock_ui = true,

	-- Panel de botones. Por defecto es una columna pegada a la derecha del
	-- recuadro de recursos de abajo a la izquierda: un botón a la altura de cada
	-- recurso (comida, madera, oro, piedra) y "Todos" encima, a la altura de la
	-- población. Valores medidos sobre una captura a 1080p con escala de
	-- interfaz normal; si no cuadra con tu pantalla, ajusta:
	--   margin       -> "izquierda,arriba,derecha,abajo" en píxeles
	--   row_height   -> separación entre recursos
	--   button_size  -> lado de cada botón cuadrado
	-- Botones cuadrados: verde y candado abierto = compartiendo; rojo y candado
	-- cerrado = bloqueado. El de marco dorado es "Todos".
	--
	-- Disposiciones (layout):
	--   "left"   -> a la izquierda, alineado con los iconos del juego y anclado
	--               ABAJO, justo encima del recuadro de población y recursos: no
	--               tapa los contadores de maravilla, edificios distintivos, etc.,
	--               ni le afecta cuántos iconos haya arriba según el mapa. Texto
	--               "Equipo: X/Y" y debajo una columna con Todos + los 4 recursos
	--               (cada uno con el icono del recurso y un candado pequeño).
	--               Por defecto: margin "22,0,0,250" (el 250 es la distancia
	--               desde abajo), button_size 30.
	--   "top"    -> la misma fila arriba a la izquierda, a la derecha de los
	--               iconos. Por defecto: margin "70,12,0,0", button_size 30.
	--   "column" -> columna pegada al recuadro de recursos de abajo a la
	--               izquierda. Por defecto: margin "200,0,0,15", row_height 39,
	--               button_size 35.
	--   "row"    -> una fila suelta abajo a la izquierda.
	-- Solo hace falta escribir los valores que quieras cambiar; el resto sale
	-- de la disposición elegida (str_ui.scar, STR_UI_DEFAULTS).
	ui = {
		layout = "left",
		-- margin = "22,0,0,250",  -- izquierda, arriba, derecha, abajo (píxeles)
		-- button_size = 30,
	},

	-- Textos localizados de los avisos ("$GUID:fila" del .locdb del mod).
	-- Los rellena el script principal del modo. Si falta alguno, el aviso
	-- solo se escribe en el log.
	--   messages.active          -> sin parámetros
	--   messages.debt[rt]        -> %1AMOUNT% = cantidad de deuda
	--   messages.locked[rt]      -> %1PLAYER% = quién lo bloquea
	--   messages.unlocked[rt]    -> %1PLAYER%
	--   messages.locked_all      -> %1PLAYER%
	--   messages.unlocked_all    -> %1PLAYER%
	--   messages.debug_*         -> avisos de depuración (ver SharedTeamResources.scar)
	messages = nil,

	-- Ejecuta además la sonda de diagnóstico (str_diagnostics.scar).
	-- Registra recursos, deltas y eventos de juego sin modificar nada.
	diagnostics = false,

	-- Si es true, la sonda funciona SIN la reserva compartida (solo observa).
	diagnostics_only = false,

	-- Intervalo de la sonda de diagnóstico, en segundos.
	diagnostics_interval = 1,
}
