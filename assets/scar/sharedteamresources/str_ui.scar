---------------------------------------------------------------------------------------------------
-- SharedResources - Botones de bloqueo
--
-- Panel con un botón por recurso y un botón para todos. Cada jugador de una
-- reserva ve SU panel, con SU estado: el bloqueo es por jugador.
--
--   Clic en un recurso -> dejas de compartir ese recurso (te quedas con lo que
--                         aportaste) o vuelves a compartirlo. Los demás siguen.
--   Clic en "Todos"    -> si compartes algo, dejas de compartirlo todo; si no,
--                         vuelves a compartirlo todo.
--
-- Diseño por defecto ("left"): a la izquierda, alineado con los iconos del
-- juego y anclado abajo, justo encima del recuadro de recursos (no le afecta
-- cuántos iconos de condiciones de victoria haya arriba). Texto "Equipo: X/Y" y debajo
-- una columna con "Todos" y los 4 recursos (icono del recurso + candado
-- pequeño). Alternativas: "top" (la misma fila arriba, a la derecha de los
-- iconos), "column" (junto al recuadro de recursos de abajo) y "row".
-- Ver STR_UI_DEFAULTS.
--
-- Por qué el contenido va ENCIMA del botón y no dentro: el estilo oficial
-- PrimaryRaisedTextButton solo dibuja texto (en mayúsculas y recortado) e
-- ignora imágenes. Así que el botón pone el fondo y el clic, y encima va un
-- marco propio (sin capturar el ratón) con el color del estado y el candado
-- oficial: verde y abierto = compartiendo; rojo y cerrado = bloqueado.
-- Los botones son cuadrados; el texto sale al pasar el ratón.
--
-- Un clic es LOCAL: se envía por red con Network_CallEvent y el cambio real se
-- aplica en STR_OnLockToggleNtw (str_main.scar), en todos los clientes a la vez.
-- Este archivo nunca toca recursos.
--
-- Posición y tamaño: STR_CONFIG.ui (str_config.scar).
---------------------------------------------------------------------------------------------------

STR_UI = {
	id = "STR_LockUI",
	created = false,
	pool = nil,
	member = nil,      -- id del jugador local en la reserva
	data = nil,
	keys = { "food", "wood", "gold", "stone" },
	-- Iconos oficiales del juego (candado abierto / cerrado).
	icon_shared = "pack://application:,,,/WPFGUI;component/images/fe/fe_unlocked_icon.png",
	icon_locked = "pack://application:,,,/WPFGUI;component/images/fe/fe_locked_icon.png",
	-- Texto que sale al pasar el ratón (el botón ya no lleva texto).
	text_shared = "Compartido",
	text_locked = "Bloqueado",
	text_lock_all = "Bloquear todo",
	text_unlock_all = "Compartir todo",
	-- Estado a simple vista: borde y fondo verdes = compartiendo; rojos = bloqueado.
	color_shared = "#FF7FD957",
	color_locked = "#FFE8553A",
	color_all = "#FFE8C25A",
	tint_shared = "#5530A040",
	tint_locked = "#66C03020",
	tint_all = "#00000000",
	-- Iconos oficiales de los recursos (los mismos que usa el panel de tributos).
	res_icons = {
		"pack://application:,,,/WPFGUI;component/icons/resources/resource_food_icon.png",
		"pack://application:,,,/WPFGUI;component/icons/resources/resource_wood_icon.png",
		"pack://application:,,,/WPFGUI;component/icons/resources/resource_gold_icon.png",
		"pack://application:,,,/WPFGUI;component/icons/resources/resource_stone_icon.png",
	},
}

-- Disposiciones:
--   "left"   -> (por defecto) a la izquierda, alineado con los iconos del juego
--               y centrado en vertical en el lateral. Texto del equipo y debajo
--               una columna con "Todos" y los 4 recursos.
--   "top"    -> arriba a la izquierda, a la derecha de los iconos: texto del
--               equipo y debajo una fila con "Todos" y los 4 recursos.
--   "column" -> columna pegada al recuadro de recursos de abajo a la izquierda,
--               un botón a la altura de cada recurso (solo candado).
--   "row"    -> una fila suelta (icono del recurso + candado pequeño).
local STR_UI_DEFAULTS = {
	-- Centrado en vertical en el lateral izquierdo.
	left = { horizontal = "Left", vertical = "Center", margin = "22,0,0,0", row_height = 34, button_size = 30 },
	top = { horizontal = "Left", vertical = "Top", margin = "70,12,0,0", row_height = 34, button_size = 30 },
	column = { horizontal = "Left", vertical = "Bottom", margin = "200,0,0,15", row_height = 39, button_size = 35 },
	row = { horizontal = "Left", vertical = "Bottom", margin = "12,0,0,300", row_height = 39, button_size = 35 },
}

local function STR_UI_Cfg()
	local cfg = STR_CONFIG.ui or {}
	local layout = cfg.layout or "left"
	local d = STR_UI_DEFAULTS[layout] or STR_UI_DEFAULTS.left
	local row_height = cfg.row_height or d.row_height
	return {
		layout = layout,
		horizontal = cfg.horizontal or d.horizontal,
		vertical = cfg.vertical or d.vertical,
		margin = cfg.margin or d.margin,
		row_height = row_height,
		button_size = cfg.button_size or d.button_size,
	}
end

-- Un botón cuadrado: el Button oficial de fondo (vacío, recibe el clic y
-- muestra el texto al pasar el ratón) y encima un marco con el color del
-- estado. Dentro del marco:
--   * en "column" (junto a cada recurso): el candado oficial abierto o cerrado;
--   * en "top"/"row" (lejos de los recursos): el icono del recurso y un
--     candado pequeño en la esquina, para saber de qué recurso es.
--   parameter -> "1".."4" o "all"
--   key       -> prefijo de los datos: <key>_icon, <key>_res, <key>_text, <key>_color, <key>_tint
local function STR_UI_Button(parameter, key, cfg, last)
	local size = cfg.button_size
	local gap = cfg.row_height - size
	local margin
	if cfg.layout == "column" then
		margin = (parameter == "all") and ("0,0,0," .. (gap + 4)) or ("0,0,0," .. gap)
	elseif cfg.layout == "left" then
		margin = last and "0,0,0,0" or ("0,0,0," .. gap)
	else
		margin = last and "0,0,0,0" or ("0,0," .. gap .. ",0")
	end
	local b = "[" .. key
	local content
	if cfg.layout == "column" or parameter == "all" then
		-- Candado centrado y siempre dentro del cuadrado (Stretch="Uniform" mantiene
		-- la proporción del icono dentro de su hueco).
		local icon = math.floor(size * 0.55)
		content = '\n\t\t\t<Image Source="{Binding ' .. b .. '_icon]}" Width="' .. icon .. '" Height="' .. icon .. '"'
			.. ' Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />'
	else
		local res = math.floor(size * 0.62)
		local badge = math.floor(size * 0.42)
		content = '\n\t\t\t<Grid>'
			.. '\n\t\t\t\t<Image Source="{Binding ' .. b .. '_res]}" Width="' .. res .. '" Height="' .. res .. '"'
			.. ' Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />'
			.. '\n\t\t\t\t<Image Source="{Binding ' .. b .. '_icon]}" Width="' .. badge .. '" Height="' .. badge .. '"'
			.. ' Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />'
			.. '\n\t\t\t</Grid>'
	end
	-- HorizontalAlignment="Left": con tamaño fijo, un Grid dentro de un panel más
	-- ancho se centraría; así queda alineado con el texto y los iconos del juego.
	return '\n\t<Grid Width="' .. size .. '" Height="' .. size .. '" Margin="' .. margin .. '" HorizontalAlignment="Left">'
		.. '\n\t\t<Button Style="{StaticResource PrimaryRaisedTextButton}" MinHeight="0" MinWidth="0"'
		.. ' Padding="0" Content="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"'
		.. ' ToolTip="{Binding ' .. b .. '_text]}"'
		.. ' Command="{Binding [click]}" CommandParameter="' .. parameter .. '" />'
		.. '\n\t\t<Border IsHitTestVisible="False" BorderThickness="2" CornerRadius="2"'
		.. ' BorderBrush="{Binding ' .. b .. '_color]}" Background="{Binding ' .. b .. '_tint]}">'
		.. content
		.. '\n\t\t</Border>'
		.. '\n\t</Grid>'
end

-- Texto con la población del equipo ("Equipo: 17/40"), solo con la población compartida.
local function STR_UI_PopulationLabel(cfg)
	local margin = "0,0,8,0"
	if cfg.layout == "column" then
		margin = "0,0,0,4"
	elseif cfg.layout == "top" or cfg.layout == "left" then
		margin = "2,0,0,4"
	end
	return '\n\t<TextBlock Text="{Binding [team_pop]}" Foreground="#FFE8C25A"'
		.. ' Style="{StaticResource HUDGray80BodyTextBlock14ptStyle}" Effect="{StaticResource DropShadowTextStyle}"'
		.. ' HorizontalAlignment="Left" VerticalAlignment="Center" Margin="' .. margin .. '" />'
end

local function STR_UI_Panel(orientation, cfg, children, outer)
	local attrs = ' Orientation="' .. orientation .. '"'
	if not outer then
		-- El panel interior no se estira al ancho del texto del equipo.
		attrs = attrs .. ' HorizontalAlignment="Left"'
	end
	if outer then
		attrs = ' xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"'
			.. ' xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"'
			.. attrs .. ' SnapsToDevicePixels="True"'
			.. ' HorizontalAlignment="' .. cfg.horizontal .. '"'
			.. ' VerticalAlignment="' .. cfg.vertical .. '"'
			.. ' Margin="' .. cfg.margin .. '"'
	end
	return '<StackPanel' .. attrs .. '>' .. table.concat(children) .. '\n</StackPanel>'
end

function STR_UI_BuildXaml()
	local cfg = STR_UI_Cfg()
	local label = STR_CONFIG.share_population and STR_UI_PopulationLabel(cfg) or nil

	if cfg.layout == "top" or cfg.layout == "left" then
		-- Texto del equipo arriba y, debajo, Todos, comida, madera, oro y piedra:
		-- en fila ("top") o en columna ("left").
		local buttons = { STR_UI_Button("all", "all", cfg, false) }
		for i, key in ipairs(STR_UI.keys) do
			buttons[#buttons + 1] = STR_UI_Button(tostring(i), key, cfg, i == #STR_UI.keys)
		end
		local children = {}
		if label ~= nil then
			children[#children + 1] = label
		end
		local inner = (cfg.layout == "top") and "Horizontal" or "Vertical"
		children[#children + 1] = '\n' .. STR_UI_Panel(inner, cfg, buttons, false)
		return STR_UI_Panel("Vertical", cfg, children, true)
	end

	local parts = {}
	if label ~= nil then
		parts[#parts + 1] = label
	end
	if cfg.layout == "column" then
		-- "Todos" arriba (altura de la población) y los recursos debajo, en el
		-- mismo orden que el recuadro del juego.
		parts[#parts + 1] = STR_UI_Button("all", "all", cfg, false)
	end
	for i, key in ipairs(STR_UI.keys) do
		parts[#parts + 1] = STR_UI_Button(tostring(i), key, cfg, false)
	end
	if cfg.layout ~= "column" then
		parts[#parts + 1] = STR_UI_Button("all", "all", cfg, true)
	end
	local orientation = (cfg.layout == "column") and "Vertical" or "Horizontal"
	return STR_UI_Panel(orientation, cfg, parts, true)
end

-- Texto localizado del CSV ("$GUID:fila") si el modo lo ha configurado; si no,
-- el texto en español de STR_UI. Va dentro de pcall por si falla la localización.
local function STR_UI_Text(kind, fallback)
	local key = STR_Message(kind)
	if key ~= nil and Loc_FormatText ~= nil then
		local ok, text = pcall(Loc_FormatText, key)
		if ok and text ~= nil then
			return text
		end
	end
	return fallback
end

-- Rellena la tabla de datos con el estado del jugador local.
function STR_UI_BuildData(pool, member)
	local data = STR_UI.data or { click = UI_CreateCommand("STR_UI_OnClick") }
	for i, key in ipairs(STR_UI.keys) do
		local rt = STR_RESOURCE_TYPES[i]
		local sharing = pool ~= nil and STR_Ledger_IsSharing(pool, member, rt)
		data[key .. "_icon"] = sharing and STR_UI.icon_shared or STR_UI.icon_locked
		data[key .. "_res"] = STR_UI.res_icons[i]
		data[key .. "_text"] = sharing and STR_UI_Text("ui_shared", STR_UI.text_shared)
			or STR_UI_Text("ui_locked", STR_UI.text_locked)
		data[key .. "_color"] = sharing and STR_UI.color_shared or STR_UI.color_locked
		data[key .. "_tint"] = sharing and STR_UI.tint_shared or STR_UI.tint_locked
	end
	local any = pool ~= nil and STR_Ledger_AnySharing(pool, member)
	-- El botón general (marco dorado) muestra lo que HARÁ al pulsarlo.
	data.all_icon = any and STR_UI.icon_locked or STR_UI.icon_shared
	data.all_text = any and STR_UI_Text("ui_lock_all", STR_UI.text_lock_all)
		or STR_UI_Text("ui_unlock_all", STR_UI.text_unlock_all)
	data.all_color = STR_UI.color_all
	data.all_tint = STR_UI.tint_all
	data.team_pop = STR_UI_PopulationText(pool)
	return data
end

-- "Equipo: usada/capacidad" de la reserva (texto del CSV, fila team_pop).
function STR_UI_PopulationText(pool)
	if pool == nil or pool.pop == nil then
		return ""
	end
	local used = math.floor(pool.pop.team_used or 0)
	local cap = math.floor(pool.pop.team_cap or 0)
	local key = STR_Message("team_pop")
	if key ~= nil and Loc_FormatText ~= nil then
		local ok, text = pcall(Loc_FormatText, key, used, cap)
		if ok and text ~= nil then
			return text
		end
	end
	return "Equipo: " .. used .. "/" .. cap
end

-- La población del equipo cambió: se actualiza el texto si es la reserva local.
function STR_UI_RefreshPopulation(pool)
	if STR_UI.created and STR_UI.pool == pool then
		STR_UI_Refresh()
	end
end

-- Crea el panel para el jugador local (si está en una reserva). Devuelve true si se creó.
function STR_UI_Create(pool)
	if pool == nil then
		return false
	end
	if STR_UI.created then
		return true
	end
	if UI_IsReplay ~= nil and UI_IsReplay() then
		return false
	end
	local _, member = STR_GetLocalMember()
	if member == nil then
		return false
	end
	local ok, err = pcall(function()
		STR_UI.pool = pool
		STR_UI.member = member
		STR_UI.data = STR_UI_BuildData(pool, member)
		UI_AddChild("ScarDefault", "XamlPresenter", STR_UI.id, {
			IsHitTestVisible = true,
			Xaml = STR_UI_BuildXaml(),
			DataContext = UI_CreateDataContext(STR_UI.data),
		})
		STR_UI.created = true
	end)
	if not ok then
		STR_LogError("No se pudo crear el panel de bloqueo:", tostring(err))
		return false
	end
	return true
end

-- Actualiza iconos, textos y colores.
function STR_UI_Refresh()
	if not STR_UI.created then
		return
	end
	-- Si el jugador local ya no está en la reserva (eliminado), se quita el panel.
	local pool = STR_UI.pool
	if not STR_Ledger_HasMember(pool, STR_UI.member) then
		STR_UI_Remove()
		return
	end
	local ok, err = pcall(function()
		STR_UI.data = STR_UI_BuildData(pool, STR_UI.member)
		UI_SetDataContext(STR_UI.id, STR_UI.data)
	end)
	if not ok then
		STR_LogError("No se pudo actualizar el panel de bloqueo:", tostring(err))
	end
end

function STR_UI_Remove()
	if not STR_UI.created then
		return
	end
	pcall(UI_Remove, STR_UI.id)
	STR_UI.created = false
end

-- Callback del botón (LOCAL). parameter = "1".."4" o "all".
function STR_UI_OnClick(parameter)
	local me = Core_GetPlayersTableEntry(Game_GetLocalPlayer())
	if me == nil or me.isEliminated then
		return
	end
	Network_CallEvent(STR_NETWORK_LOCK_EVENT, tostring(me.index) .. "," .. tostring(parameter))
end
