---------------------------------------------------------------------------------------------------
-- SharedResources - Contabilidad (ledger)
--
-- Lógica pura de la reserva compartida. NO llama a ninguna función del motor:
-- recibe lecturas de recursos y devuelve el saldo que hay que fijar.
-- Gracias a eso se puede probar fuera del juego (ver tests/).
--
-- Modelo:
--   Cada reserva tiene, por recurso, un saldo con signo (balance). Cada miembro
--   puede estar COMPARTIENDO o NO cada recurso (bloqueo por jugador). En cada
--   sincronización, para cada recurso y SOLO con los miembros que lo comparten:
--     delta_j  = lectura_actual_j - ultimo_valor_fijado_j
--     balance += suma(delta_j)
--     aporte_j += delta_j                    (lo que aporta cada uno)
--     visible  = max(balance, 0)   -> se fija a los miembros que comparten
--   Si balance < 0 hay deuda: dos jugadores gastaron a la vez el mismo saldo.
--   Los ingresos posteriores pagan la deuda antes de volver a ser visibles.
--
-- Bloqueo (por jugador y recurso):
--   El jugador sale de la reserva de ese recurso con su parte SEGÚN LO APORTADO
--   (solo cuentan aportes positivos; nunca recibe más de lo que aportó). Los
--   demás siguen compartiendo lo que queda entre ellos.
-- Desbloqueo:
--   El saldo propio del jugador vuelve a sumarse a la reserva y empieza
--   aportando lo que trae.
--
-- Invariantes (por recurso):
--   balance == inicial + ingresos - gastos - repartido + reincorporado
--   suma(aporte_j de los que comparten) == balance   (si comparte alguien)
--   Ni la sincronización ni el bloqueo crean o destruyen recursos.
---------------------------------------------------------------------------------------------------

-- Diferencias menores que esto se consideran ruido de coma flotante.
STR_LEDGER_EPSILON = 0.0001

-- Crea una reserva vacía para la lista de tipos de recurso indicada.
function STR_Ledger_New(resource_types, name)
	local pool = {
		name = name or "pool",
		types = resource_types,
		balance = {},
		members = {},        -- lista ordenada de ids (orden determinista)
		last = {},           -- last[id][rt] = último valor fijado a ese jugador
		contrib = {},        -- contrib[id][rt] = aporte neto a la reserva
		out = {},            -- out[id][rt] = true si ese jugador NO comparte ese recurso
		stats = {
			syncs = 0,
			income = {},     -- suma de deltas positivos por recurso
			spent = {},      -- suma de deltas negativos (en positivo) por recurso
			initial = {},    -- recursos iniciales aportados
			released = {},   -- repartido a jugadores que dejan de compartir
			rejoined = {},   -- reincorporado al volver a compartir
			debt_events = 0, -- veces que el saldo pasó a negativo
			max_debt = {},   -- mayor deuda observada por recurso
		},
	}
	for _, rt in ipairs(resource_types) do
		pool.balance[rt] = 0
		pool.stats.income[rt] = 0
		pool.stats.spent[rt] = 0
		pool.stats.initial[rt] = 0
		pool.stats.released[rt] = 0
		pool.stats.rejoined[rt] = 0
		pool.stats.max_debt[rt] = 0
	end
	return pool
end

function STR_Ledger_HasMember(pool, id)
	return pool.last[id] ~= nil
end

-- true si ese miembro comparte ese recurso.
function STR_Ledger_IsSharing(pool, id, rt)
	return STR_Ledger_HasMember(pool, id) and not pool.out[id][rt]
end

-- true si ese miembro comparte al menos un recurso.
function STR_Ledger_AnySharing(pool, id)
	for _, rt in ipairs(pool.types) do
		if STR_Ledger_IsSharing(pool, id, rt) then
			return true
		end
	end
	return false
end

-- Miembros que comparten ese recurso (en orden determinista).
function STR_Ledger_Sharing(pool, rt)
	local list = {}
	for _, id in ipairs(pool.members) do
		if not pool.out[id][rt] then
			list[#list + 1] = id
		end
	end
	return list
end

-- Añade un jugador compartiendo todo. Sus recursos actuales se suman a la
-- reserva (recursos iniciales). current = { [rt] = valor }
function STR_Ledger_AddMember(pool, id, current)
	if STR_Ledger_HasMember(pool, id) then
		return false
	end
	table.insert(pool.members, id)
	pool.last[id] = {}
	pool.contrib[id] = {}
	pool.out[id] = {}
	for _, rt in ipairs(pool.types) do
		local value = (current and current[rt]) or 0
		pool.balance[rt] = pool.balance[rt] + value
		pool.stats.initial[rt] = pool.stats.initial[rt] + value
		pool.contrib[id][rt] = value
		-- Todavía no se le ha fijado nada: su "último valor" es lo que tiene,
		-- así la primera sincronización no vuelve a contar estos recursos.
		pool.last[id][rt] = value
	end
	return true
end

-- Quita un jugador SIN contar sus cambios desde la última sincronización.
-- Se usa al ser eliminado: el motor puede vaciar sus recursos y eso no debe
-- descontarse de la reserva. Su aporte pasa a los que siguen compartiendo.
function STR_Ledger_RemoveMember(pool, id)
	if not STR_Ledger_HasMember(pool, id) then
		return false
	end
	local removed = pool.contrib[id]
	local removed_out = pool.out[id]
	pool.last[id] = nil
	pool.contrib[id] = nil
	pool.out[id] = nil
	for i, member in ipairs(pool.members) do
		if member == id then
			table.remove(pool.members, i)
			break
		end
	end
	for _, rt in ipairs(pool.types) do
		if not removed_out[rt] then
			local sharing = STR_Ledger_Sharing(pool, rt)
			if #sharing > 0 then
				local share = removed[rt] / #sharing
				for _, member in ipairs(sharing) do
					pool.contrib[member][rt] = pool.contrib[member][rt] + share
				end
			else
				-- Era el último que compartía: lo que quedaba era suyo y se va con él
				-- (la deuda pendiente, si la hay, se queda en la reserva).
				local left = STR_Ledger_GetVisible(pool, rt)
				pool.balance[rt] = pool.balance[rt] - left
				pool.stats.released[rt] = pool.stats.released[rt] + left
			end
		end
	end
	return true
end

-- Saldo visible (el que ven y pueden gastar los que comparten).
function STR_Ledger_GetVisible(pool, rt)
	local value = pool.balance[rt]
	if value < 0 then
		return 0
	end
	return value
end

-- Deuda actual (0 si no hay).
function STR_Ledger_GetDebt(pool, rt)
	local value = pool.balance[rt]
	if value < 0 then
		return -value
	end
	return 0
end

-- Sincroniza la reserva.
--   readings = { [id] = { [rt] = valor_actual } }   (lecturas del motor)
-- Devuelve:
--   targets = { [rt] = valor }  valor que hay que fijar a los miembros que
--                               comparten ese recurso (solo a ellos)
--   report  = { changed = bool, deltas = {[id]={[rt]=d}}, new_debt = {[rt]=d} }
function STR_Ledger_Sync(pool, readings)
	pool.stats.syncs = pool.stats.syncs + 1
	local report = { changed = false, deltas = {}, new_debt = {} }
	local targets = {}

	for _, rt in ipairs(pool.types) do
		local sharing = STR_Ledger_Sharing(pool, rt)
		if #sharing > 0 then
			local was_in_debt = pool.balance[rt] < -STR_LEDGER_EPSILON
			local total = 0
			for _, id in ipairs(sharing) do
				local reading = readings[id] and readings[id][rt]
				if reading ~= nil then
					local delta = reading - pool.last[id][rt]
					if delta > STR_LEDGER_EPSILON or delta < -STR_LEDGER_EPSILON then
						report.changed = true
						report.deltas[id] = report.deltas[id] or {}
						report.deltas[id][rt] = delta
						total = total + delta
						pool.contrib[id][rt] = pool.contrib[id][rt] + delta
						if delta > 0 then
							pool.stats.income[rt] = pool.stats.income[rt] + delta
						else
							pool.stats.spent[rt] = pool.stats.spent[rt] - delta
						end
					end
				end
			end

			pool.balance[rt] = pool.balance[rt] + total

			if pool.balance[rt] < -STR_LEDGER_EPSILON then
				if not was_in_debt then
					pool.stats.debt_events = pool.stats.debt_events + 1
					report.new_debt[rt] = -pool.balance[rt]
				end
				if -pool.balance[rt] > pool.stats.max_debt[rt] then
					pool.stats.max_debt[rt] = -pool.balance[rt]
				end
			end

			targets[rt] = STR_Ledger_GetVisible(pool, rt)
			for _, id in ipairs(sharing) do
				local reading = readings[id] and readings[id][rt]
				if reading == nil or reading ~= targets[rt] then
					report.changed = true
				end
				pool.last[id][rt] = targets[rt]
			end
		end
	end

	return targets, report
end

-- Parte de cada miembro de `ids` en `amount`, según sus aportes positivos en rt.
-- Si nadie tiene aporte positivo, a partes iguales. Suma exacta = amount.
function STR_Ledger_SplitByContribution(pool, rt, amount, ids)
	local parts = {}
	local count = #ids
	if count == 0 then
		return parts
	end
	local positive_total = 0
	for _, id in ipairs(ids) do
		local c = pool.contrib[id][rt]
		if c > 0 then
			positive_total = positive_total + c
		end
	end
	local assigned = 0
	for i, id in ipairs(ids) do
		local part
		if i == count then
			part = amount - assigned
		elseif positive_total > STR_LEDGER_EPSILON then
			part = amount * math.max(pool.contrib[id][rt], 0) / positive_total
		else
			part = amount / count
		end
		parts[id] = part
		assigned = assigned + part
	end
	return parts
end

-- El jugador `id` deja de compartir `rt`. Primero hay que sincronizar.
-- Devuelve (parte del jugador, nuevo visible para los que siguen compartiendo),
-- o nil si ya no lo compartía.
function STR_Ledger_Lock(pool, id, rt)
	if not STR_Ledger_IsSharing(pool, id, rt) then
		return nil
	end
	local sharing = STR_Ledger_Sharing(pool, rt)
	local visible = STR_Ledger_GetVisible(pool, rt)
	local fair = STR_Ledger_SplitByContribution(pool, rt, visible, sharing)
	local mine = fair[id] or 0

	pool.out[id][rt] = true
	pool.contrib[id][rt] = 0
	pool.balance[rt] = pool.balance[rt] - mine
	pool.stats.released[rt] = pool.stats.released[rt] + mine
	pool.last[id][rt] = mine

	-- Los que siguen compartiendo pasan a aportar exactamente su parte justa de
	-- lo que queda (o, si hay deuda, se la reparten a partes iguales).
	local remaining = STR_Ledger_Sharing(pool, rt)
	local others = STR_Ledger_GetVisible(pool, rt)
	for _, other in ipairs(remaining) do
		if visible > STR_LEDGER_EPSILON then
			pool.contrib[other][rt] = fair[other]
		else
			pool.contrib[other][rt] = pool.balance[rt] / #remaining
		end
		pool.last[other][rt] = others
	end
	return mine, others
end

-- El jugador `id` vuelve a compartir `rt`. reading = su saldo propio actual.
-- Devuelve el visible común que hay que fijar a todos los que comparten, o nil
-- si ya lo compartía.
function STR_Ledger_Unlock(pool, id, rt, reading)
	if not STR_Ledger_HasMember(pool, id) or STR_Ledger_IsSharing(pool, id, rt) then
		return nil
	end
	local value = reading or 0
	local sum_before = 0
	for _, other in ipairs(STR_Ledger_Sharing(pool, rt)) do
		sum_before = sum_before + pool.contrib[other][rt]
	end
	-- Si no compartía nadie, puede quedar deuda pendiente en la reserva: la asume
	-- quien vuelve (pending es 0 en cualquier otro caso).
	local pending = pool.balance[rt] - sum_before
	pool.out[id][rt] = false
	pool.balance[rt] = pool.balance[rt] + value
	pool.stats.rejoined[rt] = pool.stats.rejoined[rt] + value
	pool.contrib[id][rt] = value + pending
	local visible = STR_Ledger_GetVisible(pool, rt)
	for _, other in ipairs(STR_Ledger_Sharing(pool, rt)) do
		pool.last[other][rt] = visible
	end
	return visible
end

-- Total esperado según las estadísticas. Debe ser igual a balance (invariante).
function STR_Ledger_ExpectedBalance(pool, rt)
	local s = pool.stats
	return s.initial[rt] + s.income[rt] - s.spent[rt] - s.released[rt] + s.rejoined[rt]
end

function STR_Ledger_CheckInvariant(pool)
	for _, rt in ipairs(pool.types) do
		local diff = pool.balance[rt] - STR_Ledger_ExpectedBalance(pool, rt)
		if diff > 0.01 or diff < -0.01 then
			return false, rt, diff
		end
		local sharing = STR_Ledger_Sharing(pool, rt)
		if #sharing > 0 then
			local sum = 0
			for _, id in ipairs(sharing) do
				sum = sum + pool.contrib[id][rt]
			end
			diff = sum - pool.balance[rt]
			if diff > 0.01 or diff < -0.01 then
				return false, rt, diff
			end
		elseif pool.balance[rt] > 0.01 then
			-- Sin nadie compartiendo solo puede quedar deuda pendiente.
			return false, rt, pool.balance[rt]
		end
	end
	return true
end
